
# Database

# The app must connect as the dedicated READ-ONLY role created by db/init.sql,
# never as a superuser. `postgresql://` URLs are upgraded to `postgresql+asyncpg://`.
#
# Local (docker compose up):
DATABASE_URL=postgresql+asyncpg://sql_agent_ro:sql_agent_ro_dev_password@localhost:5432/shop
#
# Supabase (pooler): the username is `<role>.<project-ref>`, e.g.
# DATABASE_URL=postgresql://sql_agent_ro.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_S=1800


# LLM (any provider supported by langchain's init_chat_model)

# Examples: openai | anthropic | deepseek | google_genai
# Non-OpenAI providers need their extra: `uv sync --extra anthropic` etc.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Optional: OpenAI-compatible endpoint (e.g. a local gateway). Leave empty for the default.
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60


# Agent

MAX_ATTEMPTS=3
ROW_LIMIT=50
STATEMENT_TIMEOUT_MS=5000
